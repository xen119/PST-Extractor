{
  "name": "pst-extractor",
  "version": "1.12.0",
  "description": "Extract objects from MS Outlook/Exchange PST files",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "test": "run-s test:unit test:build",
    "test:build": "run-s build",
    "test:frontend": "vitest run --config frontend/vitest.config.ts",
    "test:unit": "cross-env CI=1 jest --coverage --reporters=default --reporters=jest-junit"
  },
  "repository": "epfromer/pst-extractor",
  "author": "Ed Pfromer (epfromer@gmail.com)",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/debug": "4.1.12",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "autoprefixer": "^10.4.22",
    "babel-jest": "^30.2.0",
    "cross-env": "^7.0.3",
    "debug": "^4.4.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "jsdom": "^26.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.17",
    "rimraf": "^6.1.2",
    "source-map-support": "^0.5.21",
    "vite": "^6.2.0",
    "vitest": "^2.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.13.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "iconv-lite": "^0.7.1",
    "long": "^5.3.2",
    "lucide-react": "^0.539.0",
    "mongodb": "^6.21.0",
    "nodemailer": "^8.0.11",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.9",
    "swagger-ui-dist": "^5.28.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8",
    "uuid-parse": "^1.1.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@typescript-eslint/recommended",
      "plugin:prettier/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2018,
      "sourceType": "module"
    }
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "endOfLine": "auto"
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-typescript"
    ]
  },
  "jest": {
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.spec.ts"
    ],
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.ts",
      "!<rootDir>/src/__tests__/**/*.*"
    ],
    "coverageReporters": [
      "text",
      "cobertura"
    ]
  }
}
