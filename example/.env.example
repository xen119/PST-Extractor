# Copy this file to `example/.env` and adjust the values for your machine.

HOST=127.0.0.1
PORT=3030

# Absolute or relative path to the PST folder. Relative paths resolve from example/.
# Leave blank to use the project PST/ folder.
PST_ROOT_DIR=

# Public browser origin used in invite links when behind a reverse proxy.
PUBLIC_BASE_URL=

# Default local login for the viewer.
AUTH_USERNAME=admin
AUTH_PASSWORD=pst-extractor

# Session lifetime in minutes.
AUTH_SESSION_TTL_MINUTES=180

# Invite lifetime in minutes.
AUTH_INVITE_TTL_MINUTES=1440

# Issuer label shown in authenticator apps.
AUTH_MFA_ISSUER=PST Mail Explorer

# SMTP sender settings for notification email setup.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_ADDRESS=
SMTP_REPLY_TO=

# Use MongoDB for persistent review state and local viewer users.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=pst-extractor

# Allow local or trusted IPs to skip M365 auth.
M365_AUTH_BYPASS_IPS=127.0.0.1,::1,::ffff:127.0.0.1,localhost

# Allow browser origins to call the API cross-origin.
CORS_ALLOWED_ORIGINS=
